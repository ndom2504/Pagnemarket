{
  "expo": {
    "name": "PagneMarket",
    "slug": "pagnemarket",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pagnemarket",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.tissuehub.gpxlrs",
      "infoPlist": {
        "NSCameraUsageDescription": "Photographiez votre profil ou vos tissus",
        "NSPhotoLibraryUsageDescription": "Choisissez une photo de profil ou des tissus"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.emergent.tissuehub.gpxlrs",
      "permissions": ["CAMERA", "READ_MEDIA_IMAGES", "POST_NOTIFICATIONS", "VIBRATE"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-video",
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choisissez une photo de profil ou des tissus",
          "cameraPermission": "Photographiez votre profil ou vos tissus"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#B85C38",
          "defaultChannel": "messages",
          "sounds": []
        }
      ],
      "@react-native-vector-icons/feather"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
